# Token du bot (Discord Developer Portal > ton appli > Bot > Reset Token)
DISCORD_TOKEN=

# ID du (ou des) salon(s) écouté(s), séparés par des virgules
# (Discord > Paramètres > Avancés > Mode développeur, puis clic droit sur le salon > Copier l'identifiant)
CHANNEL_IDS=

# Mot de passe partagé avec les amis : ils le mettent dans l'appli pour se connecter
ACCESS_KEY=change-moi-par-un-truc-long

# Port HTTP/WebSocket (les hébergeurs comme Railway le fixent eux-mêmes)
PORT=8080

# Autoriser les messages texte sans média (true/false)
ALLOW_TEXT_ONLY=true

# Le bot réagit avec cet emoji quand un message est envoyé aux amis (vide = pas de réaction)
ACK_EMOJI=📺
